# Copy to .env.local and fill in. Never commit real values.
# Local values: run `npx supabase status` after `npm run db:start`.

# --- Public (safe in the browser bundle) ---------------------------------
# Supabase API URL. Local: http://127.0.0.1:55421
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key (starts with sb_publishable_). "PUBLISHABLE_KEY" in `supabase status`.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public base URL of this app, used for auth redirects and invite links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Server only (NEVER prefix with NEXT_PUBLIC_, never import in client code) ---
# Supabase secret key (starts with sb_secret_). "SECRET_KEY" in `supabase status`.
# Bypasses RLS: read only by src/lib/supabase/admin.ts (account admin:
# creating logins, resetting passwords, deactivating) and by
# scripts/create-super-admin.mjs. Regular tenant data paths use the
# signed-in user's session instead.
SUPABASE_SECRET_KEY=

# --- WhatsApp Cloud API (server only; optional until a business is connected) ---
# Meta app → App settings → Basic → App secret. Used to verify webhook calls.
WHATSAPP_APP_SECRET=
# Any long random string; enter the same value in Meta's webhook setup.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Graph API version shown in your Meta app dashboard (default v21.0).
WHATSAPP_GRAPH_API_VERSION=
# Leave empty in real use (defaults to https://graph.facebook.com). Tests point it at a mock.
WHATSAPP_API_BASE_URL=
# Long random string. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
# when it calls /api/cron/evening-reminders at 9 PM IST. Set it in Vercel too.
CRON_SECRET=

# --- Meta "Connect with Meta" button (optional; after Tech Provider approval) ---
# Meta app ID and the Embedded Signup configuration ID (public values).
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_ES_CONFIG_ID=
