# Copy to .env.local and fill in. Never commit real values.
# Local values: run `npx supabase status` after `npm run db:start`.

# --- Public (safe in the browser bundle) ---------------------------------
# Supabase API URL. Local: http://127.0.0.1:55421
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key (starts with sb_publishable_). "PUBLISHABLE_KEY" in `supabase status`.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public base URL of this app, used for auth redirects and invite links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Server only (NEVER prefix with NEXT_PUBLIC_, never import in client code) ---
# Supabase secret key (starts with sb_secret_). "SECRET_KEY" in `supabase status`.
# Bypasses RLS: read only by src/lib/supabase/admin.ts (account admin:
# creating logins, resetting passwords, deactivating) and by
# scripts/create-super-admin.mjs. Regular tenant data paths use the
# signed-in user's session instead.
SUPABASE_SECRET_KEY=
